    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>Bindery.Ra2.Adapter.Channel</AssemblyName>
    <RootNamespace>Bindery.Ra2.Adapter.ChannelTool</RootNamespace>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <!-- The channel plays the same live match as the acceptance harness. -->
    <Compile Include="../Bindery.Ra2.Adapter.LiveAcceptance/LiveAcceptanceSettings.cs" Link="LiveAcceptanceSettings.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Bindery.Ra2.Adapter/Bindery.Ra2.Adapter.csproj" />
  </ItemGroup>
</Project>
