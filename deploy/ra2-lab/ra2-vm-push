#!/usr/bin/env python3
# Copy a file into an RA2 lab guest through the QEMU guest agent (qemu:///session).
#   ra2-vm-push <domain> <local-file> <guest-path>
import base64, json, os, subprocess, sys

URI = os.environ.get("LIBVIRT_DEFAULT_URI", "qemu:///session")
CHUNK = 64 * 1024  # base64 of each chunk must stay well inside libvirt's message limit


def agent(domain, cmd):
    out = subprocess.run(["virsh", "-c", URI, "qemu-agent-command", domain, json.dumps(cmd)],
                         check=True, capture_output=True, text=True).stdout
    return json.loads(out)["return"]


domain, local, remote = sys.argv[1:4]
data = open(local, "rb").read()
h = agent(domain, {"execute": "guest-file-open", "arguments": {"path": remote, "mode": "wb"}})
try:
    for i in range(0, len(data), CHUNK):
        agent(domain, {"execute": "guest-file-write",
                       "arguments": {"handle": h, "buf-b64": base64.b64encode(data[i:i + CHUNK]).decode()}})
finally:
    agent(domain, {"execute": "guest-file-close", "arguments": {"handle": h}})
print(f"pushed {len(data)} bytes to {domain}:{remote}")
