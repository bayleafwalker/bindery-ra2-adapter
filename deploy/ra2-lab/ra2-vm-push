#!/usr/bin/env python3
# Copy a file into an RA2 lab guest through the QEMU guest agent (qemu:///session).
#   ra2-vm-push <domain> <local-file> <guest-path>
import base64, json, os, subprocess, sys

URI = os.environ.get("LIBVIRT_DEFAULT_URI", "qemu:///session")
CHUNK = 64 * 1024  # base64 of each chunk must stay well inside libvirt's message limit


def agent(domain, cmd):
    out = subprocess.run(["virsh", "-c", URI, "qemu-agent-command", domain, json.dumps(cmd)],
                         check=True, capture_output=True, text=True).stdout
    return json.loads(out)["return"]


domain, local, remote = sys.argv[1:4]
data = open(local, "rb").read()
def write_all(domain, handle, data):
    """Write every chunk in one virsh session fed on stdin: file contents
    (tokens included) must not appear in a command line, which ps shows."""
    script = "".join(
        "qemu-agent-command {} '{}'\n".format(domain, json.dumps(
            {"execute": "guest-file-write",
             "arguments": {"handle": handle, "buf-b64": base64.b64encode(data[i:i + CHUNK]).decode()}}))
        for i in range(0, len(data), CHUNK))
    done = subprocess.run(["virsh", "-q", "-c", URI], input=script, capture_output=True, text=True)
    written = sum(json.loads(line[line.index("{"):])["return"]["count"]
                  for line in done.stdout.splitlines() if '{"return"' in line)
    # In stdin mode virsh can exit 0 after a failed command: check the errors and the byte count.
    if done.returncode != 0 or "error:" in done.stderr or written != len(data):
        raise RuntimeError(f"guest-file-write to {domain} wrote {written} of {len(data)} bytes: {done.stderr.strip()}")


h = agent(domain, {"execute": "guest-file-open", "arguments": {"path": remote, "mode": "wb"}})
try:
    write_all(domain, h, data)
finally:
    agent(domain, {"execute": "guest-file-close", "arguments": {"handle": h}})
print(f"pushed {len(data)} bytes to {domain}:{remote}")
