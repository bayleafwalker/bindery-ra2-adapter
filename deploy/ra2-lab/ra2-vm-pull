#!/usr/bin/env python3
# Copy a file out of an RA2 lab guest through the QEMU guest agent (qemu:///session).
#   ra2-vm-pull <domain> <guest-path> <local-file>
import base64, json, os, subprocess, sys

URI = os.environ.get("LIBVIRT_DEFAULT_URI", "qemu:///session")
# A 4 MiB read base64-encodes past libvirt's message limit ("Unable to encode
# message payload") and still advances the guest's file offset.
CHUNK = 1024 * 1024


def agent(domain, cmd):
    out = subprocess.run(["virsh", "-c", URI, "qemu-agent-command", domain, json.dumps(cmd)],
                         check=True, capture_output=True, text=True).stdout
    return json.loads(out)["return"]


domain, remote, local = sys.argv[1:4]
h = agent(domain, {"execute": "guest-file-open", "arguments": {"path": remote, "mode": "rb"}})
try:
    with open(local, "wb") as f:
        while True:
            r = agent(domain, {"execute": "guest-file-read", "arguments": {"handle": h, "count": CHUNK}})
            f.write(base64.b64decode(r.get("buf-b64", "")))
            if r.get("eof") or r.get("count", 0) == 0:
                break
finally:
    agent(domain, {"execute": "guest-file-close", "arguments": {"handle": h}})
