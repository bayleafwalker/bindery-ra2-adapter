<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CA1303;CA1305;CA1307;CA1310;CA1311;CA1812;CA1822;CA1848;CA2007;CS1591;CA1031;CA1062;CA1515;CA1852;IDE0005</NoWarn>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <AnalysisLevel>none</AnalysisLevel>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Bindery.Ra2.Bot.Arena/Bindery.Ra2.Bot.Arena.csproj" />
    <ProjectReference Include="../../src/Bindery.Ra2.Bot/Bindery.Ra2.Bot.csproj" />
    <ProjectReference Include="../../src/Bindery.Ra2.Bot.Sim/Bindery.Ra2.Bot.Sim.csproj" />
  </ItemGroup>
</Project>
